# Runs once, before any interpreter is tested, so it must not assume or leave
# behind a particular Python: activating .venv here pinned everything that
# followed to the primary interpreter, and it was never deactivated.
# zopen_python_test below gets the right environment from zopen-build instead.
zopen_pre_check() {
    sed -i "1s|^python |python3 |;1s|^python$|python3|" .appenv 2>/dev/null || true
    # Recreate tests/helper.py omitted from the PyPI sdist (needed by test suite)
    if [ -d tests ] && [ ! -f tests/helper.py ]; then
        cat > tests/helper.py <<'HELPEREOF'
def u32_to_s32(x):
    return x - 0x100000000 if x >= 0x80000000 else x


def u64_to_s64(x):
    return x - 0x10000000000000000 if x >= 0x8000000000000000 else x
HELPEREOF
    fi
}

# Run the tests for one interpreter. zopen-build calls this once per Python
# version being built, with that version's virtual environment already active
# and the wheel built for it already installed, so 'python' here is the right
# interpreter and dist/ never has to be inspected.
#
# Running from a copy of tests/ outside the source tree is what makes the
# installed wheel the thing under test: the source tree holds an mmh3 package
# directory that would otherwise shadow it. That is also why no .so has to be
# copied back into the source tree -- the import never resolves there.
zopen_python_test() {
  test_dir="/tmp/${ZOPEN_PROJECT_NAME}_tests_$$"
  rm -rf "${test_dir}"
  mkdir -p "${test_dir}" || return $?
  cp -R tests/* "${test_dir}/" || return $?

  (cd "${test_dir}" && python -m pytest -v)
  zopen_check_result=$?

  rm -rf "${test_dir}"
  return "${zopen_check_result}"
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="$1/$2_check.log"
  totalTests=$(grep -oE "([0-9]+) passed" "${chk}" | awk '{sum += $1} END {print sum+0}')
  actualFailures=$(grep -oE "([0-9]+) (error|failed)" "${chk}" | awk '{sum += $1} END {print sum+0}')
  if grep -q "collected 0 items" "${chk}"; then
    totalTests=0
    actualFailures=0
  fi
  echo "actualFailures:${actualFailures}"
  echo "totalTests:${totalTests}"
  echo "expectedFailures:0"
}

