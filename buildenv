# Auto-generated: activate venv before check
zopen_pre_check() {
    sed -i "1s|^python |python3 |;1s|^python$|python3|" .appenv 2>/dev/null || true
    . .venv/bin/activate
    # Recreate tests/helper.py omitted from the PyPI sdist (needed by test suite)
    if [ -d tests ] && [ ! -f tests/helper.py ]; then
        cat > tests/helper.py <<'HELPEREOF'
def u32_to_s32(x):
    return x - 0x100000000 if x >= 0x80000000 else x


def u64_to_s64(x):
    return x - 0x10000000000000000 if x >= 0x8000000000000000 else x
HELPEREOF
    fi
# Auto-generated: copy .so from site-packages to source (ZOPEN_C_EXT_SO_COPY_FIX)
# When tests run from the source directory, Python finds the source
# tree package instead of site-packages. Copying .so files into the
# source tree ensures compiled modules are found.
# NOTE: z/OS find does NOT support "-not -path" — must use -prune instead
# NOTE: "./" covers the source-root cwd; "*/" covers the port-dir cwd.
for _d in ./ */; do
  if [ -f "${_d}setup.py" ] || [ -f "${_d}pyproject.toml" ]; then
    for _sitepkg in "${_d}".venv/lib/python3*/site-packages; do
      [ -d "${_sitepkg}" ] || continue
      find "${_sitepkg}" -name "*.so" -type f 2>/dev/null | while IFS= read -r _so; do
        _rel="${_so#${_sitepkg}/}"
        _pkgpart="${_rel%%/*}"
        _srcdir=$(find "${_d}" -name .venv -prune -o -name build -prune -o -name site-packages -prune -o -name .git -prune -o -type d -name "${_pkgpart}" -print 2>/dev/null | head -1)
        if [ -n "${_srcdir}" ]; then
          _subpath="${_rel#${_pkgpart}/}"
          _dest="${_srcdir}/${_subpath}"
          _destdir=$(dirname "${_dest}")
          mkdir -p "${_destdir}" 2>/dev/null
          cp -f "${_so}" "${_dest}" 2>/dev/null
        fi
      done
    done
  fi
done

}

zopen_custom_check() {
  . .venv/bin/activate
  pip install pytest || return $?
  pip install --force-reinstall --no-deps dist/*.whl || return $?
  test_dir="/tmp/${ZOPEN_PROJECT_NAME}_tests_$$"
  mkdir -p "${test_dir}" || return $?
  cp -R tests/* "${test_dir}/" || return $?
  cd "${test_dir}" || return $?
  python -m pytest -v
  zopen_check_result=$?
  cd - > /dev/null
  rm -rf "${test_dir}"
  deactivate
  return "${zopen_check_result}"
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="$1/$2_check.log"
  totalTests=$(grep -oE "([0-9]+) passed" "${chk}" | awk '{sum += $1} END {print sum+0}')
  actualFailures=$(grep -oE "([0-9]+) (error|failed)" "${chk}" | awk '{sum += $1} END {print sum+0}')
  if grep -q "collected 0 items" "${chk}"; then
    totalTests=0
    actualFailures=0
  fi
  echo "actualFailures:${actualFailures}"
  echo "totalTests:${totalTests}"
  echo "expectedFailures:0"
}

export ZOPEN_CHECK="zopen_custom_check"
